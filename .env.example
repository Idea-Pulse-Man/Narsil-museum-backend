# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the museum-app dev server).
# Use * to allow any origin (handy for LAN / mobile testing via ngrok).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Absolute public origin of THIS backend. Used to build proxied image URLs
# (see IMAGE_DELIVERY). When exposing via ngrok, set this to the ngrok URL.
PUBLIC_BASE_URL=http://localhost:4000

# How artwork images reach the frontend:
#   proxy  (default) — backend fetches the IIIF 3.0 image and streams it, so the
#                      app loads every image from this origin (no CORS/hotlink
#                      issues, and bypasses museum image-server bot blocking).
#   direct           — artwork.image is the raw upstream IIIF 3.0 URL.
IMAGE_DELIVERY=proxy

# ── Museum Public API (source of artwork + artist metadata) ───────────────
# The Art Institute of Chicago public API. No key required.
MUSEUM_API_BASE_URL=https://api.artic.edu/api/v1

# ── IIIF Image API 3.0 ────────────────────────────────────────────────────
# Base URL of the IIIF image server. Artwork images are built as
#   {IIIF_BASE_URL}/{identifier}/{region}/{size}/{rotation}/{quality}.{format}
# Leave blank to auto-discover it from the museum API `config.iiif_url` field.
IIIF_BASE_URL=https://www.artic.edu/iiif/2
# Requested image width in pixels (IIIF size = "{width},"). 843 is AIC-cached.
IIIF_IMAGE_WIDTH=843

# ── Catalog ───────────────────────────────────────────────────────────────
# How many public-domain artworks to pull from the museum API.
CATALOG_LIMIT=80
# In-memory cache lifetime for the fetched catalog (milliseconds).
CATALOG_CACHE_TTL_MS=3600000
