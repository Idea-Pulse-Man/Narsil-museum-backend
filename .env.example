# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
#  - Local dev: the Vite dev server (5173) + the native iOS app.
#  - Vercel: any *.vercel.app frontend is auto-allowed in code, so you can
#    leave this UNSET in the Vercel dashboard.
# Use * to allow any origin (handy for LAN / mobile testing via ngrok).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,capacitor://localhost

# Absolute public origin of THIS backend. Used to build proxied image URLs
# (see IMAGE_DELIVERY). When exposing via ngrok, set this to the ngrok URL.
# On Vercel leave this UNSET — it's derived from VERCEL_URL automatically.
PUBLIC_BASE_URL=http://localhost:4000

# How artwork images reach the frontend:
#   proxy  (default) — backend fetches the IIIF 3.0 image and streams it, so the
#                      app loads every image from this origin (no CORS/hotlink
#                      issues, and works even when a museum image server blocks
#                      the browser's network).
#   direct           — artwork.image is the raw upstream IIIF 3.0 URL.
IMAGE_DELIVERY=proxy

# ── Museum source(s) ─────────────────────────────────────────────────────────
# Which museum Public API(s) to source artworks + artists from. Comma list —
# the ingestion job (`npm run ingest`) pulls from EVERY source listed here and
# upserts the merged result into Supabase (each source's artist/artwork ids
# carry a source prefix, so there's no collision risk). The live web API
# (CatalogService) reads the merged catalog straight from Supabase — it never
# calls a museum API directly — so a source only shows up in the app AFTER an
# ingest run has populated Supabase with it.
#   wellcome (default) — Wellcome Collection. Serves IIIF Image API 3.0 images
#                        the backend can fetch + stream, so images always show.
#   artic              — Art Institute of Chicago. Richer fine-art metadata, but
#                        its IIIF image server blocks non-browser clients, so
#                        during ingestion its images are HOTLINKED (the raw
#                        www.artic.edu URL is stored instead of an S3 copy —
#                        browsers load them fine, but they stay on AIC's
#                        infrastructure).
#   met                — The Metropolitan Museum of Art. CC0 (public domain),
#                        no API key, ~490k objects. Re-hosting to S3 + permanent
#                        storage is allowed and safe for commercial use. Carries
#                        ready-made image URLs (no IIIF). Recommended 2nd source.
#   cma                — Cleveland Museum of Art Open Access. CC0, no API key,
#                        ~41k works with images, first-party cc0/has_image
#                        filters and ready-made CDN image URLs. The friendliest
#                        source for ingestion.
#   rijks              — Rijksmuseum, via the new Data Services (Search API +
#                        Linked Art + IIIF images, data.rijksmuseum.nl, no API
#                        key). Only works whose image carries a public-domain
#                        rights mark are ingested.
#   flickr             — Flickr Commons photostreams: Library of Congress +
#                        British Library by default (their own APIs are
#                        unusable server-side). Needs FLICKR_API_KEY below;
#                        skipped with a notice while the key is unset.
MUSEUM_SOURCES=wellcome

# OpenAI API key — powers AI placard descriptions for thin/boilerplate records
# only (good museum prose is never rewritten). Used by
# `npm run backfill:descriptions`. While unset, the AI tier silently no-ops and
# placards keep their deterministic wall text.
OPENAI_API_KEY=
# Chat model for wall-text generation (default: gpt-5.5). Any chat-completions
# model works; a small/mini model is plenty for 2-sentence placards.
# OPENAI_MODEL=gpt-5.5

# Free Flickr API key (https://www.flickr.com/services/api/keys/) — required
# only for the "flickr" source. While unset, that source is skipped.
FLICKR_API_KEY=
# Flickr Commons account NSIDs the "flickr" source pulls from (comma list).
# Leave unset for the defaults: 8623220@N02 (The Library of Congress) and
# 12403504@N02 (The British Library).
# FLICKR_ACCOUNTS=8623220@N02,12403504@N02

# Back-compat alias for MUSEUM_SOURCES — only read when MUSEUM_SOURCES is unset.
# MUSEUM_SOURCE=wellcome

# Museum Public API base URL, applied to the FIRST source in MUSEUM_SOURCES.
# Leave unset to use that source's default:
#   wellcome → https://api.wellcomecollection.org/catalogue/v2
#   artic    → https://api.artic.edu/api/v1
#   met      → https://collectionapi.metmuseum.org/public/collection/v1
#   cma      → https://openaccess-api.clevelandart.org/api
#   rijks    → https://data.rijksmuseum.nl
# MUSEUM_API_BASE_URL=

# ── IIIF Image API 3.0 ────────────────────────────────────────────────────
# Base URL of the IIIF image server, applied to the FIRST source in
# MUSEUM_SOURCES. Artwork images are built as
#   {IIIF_BASE_URL}/{identifier}/{region}/{size}/{rotation}/{quality}.{format}
# Leave unset to use that source's default:
#   wellcome → https://iiif.wellcomecollection.org/image
#   artic    → https://www.artic.edu/iiif/2
#   (met has no IIIF server — it carries ready-made image URLs)
# IIIF_BASE_URL=
# Requested image width in pixels (IIIF size = "{width},").
IIIF_IMAGE_WIDTH=800

# ── Catalog ───────────────────────────────────────────────────────────────
# How many public-domain artworks to pull from the museum API.
CATALOG_LIMIT=80
# In-memory cache lifetime for the fetched catalog (milliseconds).
CATALOG_CACHE_TTL_MS=3600000

# ===========================================================================
# DAILY INGESTION JOB  (npm run ingest) — EC2 only, NOT used by the web API
# ---------------------------------------------------------------------------
# Pulls public-domain art, uploads images to S3, upserts into Supabase so the
# app can read the catalog directly from Supabase.
#
# IMPORTANT: use MUSEUM_SOURCES=wellcome,met for ingestion (or just "wellcome").
# The Art Institute (artic) IIIF server returns 403 to server-side downloads, so
# its images can't be stored in S3. The Met (met) is CC0 and key-free, so it
# re-hosts to S3 with no issues.
# ===========================================================================

# ── AWS S3 ─────────────────────────────────────────────────────────────────
AWS_REGION=us-east-2
S3_BUCKET=narsil-backend-images
# Folder (key prefix) for artwork images — must be publicly readable.
S3_PREFIX=artworks
# Folder for artist portraits. Defaults to a subfolder of S3_PREFIX so the same
# public bucket policy (artworks/*) already covers it — no AWS change needed.
S3_ARTIST_PREFIX=artworks/artists
# Public base URL images are served from (no trailing slash).
#   Public bucket:  https://<bucket>.s3.<region>.amazonaws.com
#   CloudFront:     https://<distribution-id>.cloudfront.net
S3_PUBLIC_BASE_URL=https://narsil-backend-images.s3.us-east-2.amazonaws.com
# NOTE: On EC2, AWS credentials come from the instance IAM role
# (narsil-ec2-role) automatically — do NOT put access keys here.

# ── Supabase (SERVICE ROLE — secret, server-side only) ──────────────────────
SUPABASE_URL=https://oocqhiojgtjrkvdsthzz.supabase.co
# Supabase → Settings → API → service_role (secret). NEVER expose to the app.
SUPABASE_SERVICE_ROLE_KEY=

# ── Canvas checkout: Stripe (payment) + Printful (fulfillment) ──────────────
# Flow: app → POST /api/checkout/payment-intent → Stripe.js payment →
#       payment_intent.succeeded webhook → backend creates the Printful order.
# Stripe secret key (Dashboard → Developers → API keys). sk_test_… for dev.
STRIPE_SECRET_KEY=
# Webhook signing secret for POST /api/stripe/webhook (whsec_…).
# Local dev: `stripe listen --forward-to localhost:4000/api/stripe/webhook`
# prints one. Without a webhook the app's finalize call still completes orders.
STRIPE_WEBHOOK_SECRET=
# Printful private token (https://developers.printful.com → Tokens).
PRINTFUL_API_KEY=
# Required only when the token can access more than one store.
PRINTFUL_STORE_ID=
# Shared secret guarding the Printful status webhook (any random string).
# Register the webhook in Printful (Settings → Webhooks) pointing at
#   https://<backend>/api/printful/webhook?secret=<this value>
# with events: package_shipped, order_canceled, order_failed. This is what
# moves orders to shipped (with tracking) in the app's order history.
PRINTFUL_WEBHOOK_SECRET=
# "true" submits orders for fulfillment immediately (real costs!). Default
# creates DRAFT orders you confirm by hand in the Printful dashboard.
PRINTFUL_CONFIRM_ORDERS=false
# Printful catalog product for canvas prints (3 = "Canvas (in)").
PRINTFUL_CANVAS_PRODUCT_ID=3
# Optional: pin exact catalog variant ids per size. Leave unset to auto-match
# by dimensions (Small 12×16", Medium 18×24", Large 24×36").
# PRINTFUL_VARIANT_SMALL=
# PRINTFUL_VARIANT_MEDIUM=
# PRINTFUL_VARIANT_LARGE=
# Currency the canvas prices are charged in.
CHECKOUT_CURRENCY=usd

# ── Ingestion tuning ────────────────────────────────────────────────────────
# Width (px) of the image uploaded to S3.
INGEST_IMAGE_WIDTH=843
# Skip images already present in S3 (set to "false" to force re-upload).
INGEST_SKIP_EXISTING=true
# Parallel image downloads/uploads.
INGEST_CONCURRENCY=6
# Resolve artist portraits (Wikidata) and store them in S3 (set "false" to skip).
INGEST_ARTIST_PHOTOS=true
